[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://examples/text_effect_presets/preset_demo.gd" id="1"]
[ext_resource type="SpireRichTextEffectPreset" path="res://examples/text_effect_presets/enchanted.tres" id="2"]
[ext_resource type="SpireRichTextEffectPreset" path="res://examples/text_effect_presets/warning.tres" id="3"]

[node name="TextPresetDemo" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.045, 0.06, 0.1, 1)

[node name="Title" type="Label" parent="."]
offset_left = 40.0
offset_top = 30.0
offset_right = 900.0
offset_bottom = 80.0
theme_override_font_sizes/font_size = 32
text = "Reusable text effects"

[node name="Description" type="Label" parent="."]
offset_left = 40.0
offset_top = 90.0
offset_right = 900.0
offset_bottom = 150.0
theme_override_colors/font_color = Color(0.65, 0.72, 0.85, 1)
text = "Presets animate tagged text. The buttons apply ordinary character tweens.\nInspect enchanted.tres or warning.tres to edit the loops."

[node name="Text" type="SpireRichTextLabel" parent="."]
offset_left = 40.0
offset_top = 190.0
offset_right = 930.0
offset_bottom = 400.0
theme_override_font_sizes/normal_font_size = 38
bbcode_enabled = true
text = "[enchanted]Characters in motion[/enchanted]\n\n[warning_text]Something is approaching![/warning_text]"
effect_presets = Array[SpireRichTextEffectPreset]([ExtResource("2"), ExtResource("3")])

[node name="Buttons" type="HBoxContainer" parent="."]
offset_left = 40.0
offset_top = 450.0
offset_right = 700.0
offset_bottom = 505.0
theme_override_constants/separation = 16

[node name="Punch" type="Button" parent="Buttons"]
custom_minimum_size = Vector2(180, 48)
layout_mode = 2
text = "Punch from code"

[node name="Fade" type="Button" parent="Buttons"]
custom_minimum_size = Vector2(180, 48)
layout_mode = 2
text = "Fade from code"

[node name="Reset" type="Button" parent="Buttons"]
custom_minimum_size = Vector2(180, 48)
layout_mode = 2
text = "Reset code effects"

[connection signal="pressed" from="Buttons/Punch" to="." method="_on_punch_pressed"]
[connection signal="pressed" from="Buttons/Fade" to="." method="_on_fade_pressed"]
[connection signal="pressed" from="Buttons/Reset" to="." method="_on_reset_pressed"]
