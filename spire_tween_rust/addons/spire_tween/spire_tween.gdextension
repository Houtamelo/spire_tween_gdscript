[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.4"
reloadable=true

[libraries]
linux.debug.x86_64 = "res://addons/spire_tween/lib/x86_64-unknown-linux-gnu/debug/libspire_tween_rust.so"
linux.release.x86_64 = "res://addons/spire_tween/lib/x86_64-unknown-linux-gnu/release/libspire_tween_rust.so"

windows.debug.x86_64 = "res://addons/spire_tween/lib/x86_64-pc-windows-msvc/debug/spire_tween_rust.dll"
windows.release.x86_64 = "res://addons/spire_tween/lib/x86_64-pc-windows-msvc/release/spire_tween_rust.dll"

macos.debug.arm64 = "res://addons/spire_tween/lib/aarch64-apple-darwin/debug/libspire_tween_rust.dylib"
macos.release.arm64 = "res://addons/spire_tween/lib/aarch64-apple-darwin/release/libspire_tween_rust.dylib"
macos.debug.x86_64 = "res://addons/spire_tween/lib/x86_64-apple-darwin/debug/libspire_tween_rust.dylib"
macos.release.x86_64 = "res://addons/spire_tween/lib/x86_64-apple-darwin/release/libspire_tween_rust.dylib"
