config_version=5

[application]
config/name="SpireTween Showcase"
run/main_scene="res://main.tscn"
run/flush_stdout_on_print=true
config/use_hidden_project_data_directory=false
boot_splash/show_image=false

[display]
window/size/viewport_width=1200
window/size/viewport_height=900
window/size/window_width_override=1200
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.075, 1)
