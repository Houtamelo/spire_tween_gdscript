extends SceneTree
func _initialize(): call_deferred("run")
func run():
    var leader := Node2D.new()
    var follower := Node2D.new()
    root.add_child(leader)
    root.add_child(follower)
    leader.position = Vector2(1,0)
    var follow := DoNode2D.follow(follower, leader, 1.0).set_process_mode(Spire.PROCESS_MODE_MANUAL)
    follow.custom_step(1.1)
    print("AUDIT_EXTRA follow_caught_target ", JSON.stringify({"stopped":follow.is_stopped(),"loops":follow.get_loops(),"position":str(follower.position)}))
    var node := Node3D.new()
    root.add_child(node)
    var circle := DoNode3D.circle(node, Vector3.ZERO, 0.0, TAU, 2.0, Vector3.UP, 1.0).set_process_mode(Spire.PROCESS_MODE_MANUAL)
    circle.custom_step(1.0)
    print("AUDIT_EXTRA circle_end ", str(node.position))
    var seq := Spire.sequence().set_process_mode(Spire.PROCESS_MODE_MANUAL)
    seq.insert(0.5, Spire.do_delayed_call(func():pass, 1.0))
    seq.custom_step(0.25)
    print("AUDIT_EXTRA future_insert_source_parent_playing ", seq.is_playing())
    follow.unregister()
    circle.unregister()
    seq.unregister()
    leader.queue_free()
    follower.queue_free()
    node.queue_free()
    for i in range(2): await process_frame
    quit(0)
